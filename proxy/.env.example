# THE PUBLISHING STACK'S VARIABLES. Copy this file to `.env` beside it, and fill it in:
#
#   cp proxy/.env.example proxy/.env
#
# The copy is ignored by git (.env matches at any depth); this template is not.
#
# The three AUTHELIA_* values are SECRETS. Generate each one ON THE NAS, and
# generate a different one for each:
#
#   docker run --rm authelia/authelia:4.38.10 \
#     authelia crypto rand --length 64 --charset alphanumeric
#
# AUTHELIA_STORAGE_ENCRYPTION_KEY encrypts the stored passkey registrations --
# changing it after enrolment makes the phone's passkey unreadable, and the
# recovery is to enrol again.

# The DDNS hostname. The certificate is issued for it and it is the WebAuthn
# relying-party id, so it must be the name the phone actually opens.
DOMAIN=monitor.example.invalid

TZ=Europe/Helsinki

# Where NPM keeps its data and its certificates.
PROXY_DATA=/share/CACHEDEV1_DATA/Programs/sentinel/proxy

# The two macvlan addresses. Both must be free on the LAN.
PROXY_IPV4=198.51.100.20
AUTHELIA_IPV4=198.51.100.21

AUTHELIA_SESSION_SECRET=
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
